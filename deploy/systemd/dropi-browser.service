[Unit]
Description=Persistent authenticated browser for Dropi CAS
Requires=dropi-xvfb.service
After=dropi-xvfb.service network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=DISPLAY=:99
ExecStart=/usr/bin/google-chrome --no-sandbox --disable-gpu --disable-dev-shm-usage --no-first-run --no-default-browser-check --remote-debugging-address=127.0.0.1 --remote-debugging-port=9229 --user-data-dir=%h/.hermes/browser-profiles/dropi-yevalo https://app.dropi.co/
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=yes
PrivateDevices=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=default.target
