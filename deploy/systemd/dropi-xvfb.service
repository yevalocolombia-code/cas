[Unit]
Description=Virtual display for the persistent Dropi browser
After=network.target

[Service]
Type=simple
User=dropicas
Group=dropicas
ExecStart=/usr/bin/Xvfb :99 -screen 0 1280x1024x24 -nolisten tcp -noreset
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateDevices=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
